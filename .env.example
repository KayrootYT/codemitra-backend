# Copy to .env on the Oracle VM. Never commit real secrets.
NVIDIA_API_KEY=replace-with-your-provider-key
MODEL=deepseek-ai/deepseek-v4.1-flash

# Use the open-source Hindi Piper voices; ElevenLabs is not required.
TTS_PROVIDER=piper
PIPER_MODEL_DIR=/var/lib/codemitra/piper

# Comma-separated browser origins. Keep the GitHub Pages origin.
ALLOWED_ORIGINS=https://kayrootyt.github.io

# Set this to a hostname you control and point its DNS to the VM public IP.
API_DOMAIN=api.example.com

# Optional only if you later enable ElevenLabs features.
# ELEVENLABS_API_KEY=
# VOICE_MALE_ID=
# VOICE_FEMALE_ID=
