# Render Dashboard → Environment. Never commit real secrets.
NVIDIA_API_KEY=replace-with-your-provider-key
MODEL=deepseek-ai/deepseek-v4.1-flash

# Open-source Hindi TTS. No ElevenLabs key is needed.
TTS_PROVIDER=piper
PIPER_MODEL_DIR=/tmp/codemitra-piper

# Comma-separated browser origins.
ALLOWED_ORIGINS=https://kayrootyt.github.io

# Optional only if you later enable ElevenLabs features.
# ELEVENLABS_API_KEY=
# VOICE_MALE_ID=
# VOICE_FEMALE_ID=
